# Скопируйте в .env и поменяйте пароли. Сам .env в git не попадает.

# База. Из этих же значений compose.yaml собирает строку подключения для API (ConnectionStrings__Default),
# отдельно её задавать не нужно. В пароле только латиница, цифры, - и _: символы ; и кавычки ломают строку подключения.
POSTGRES_DB=dekanat
POSTGRES_USER=dekanat
POSTGRES_PASSWORD=dekanat-local-only

# Порты на этой машине, оба слушают только 127.0.0.1.
# HTTP_PORT: адрес сайта. Пока nginx с фронтом нет в compose, на нём отвечает API: http://localhost:8080/api/health
# DB_PORT: база для IDE и psql. 5433, чтобы не конфликтовать с локальным PostgreSQL на 5432.
HTTP_PORT=8080
DB_PORT=5433

# Ключ от модели нужен только серверу. Настоящий ключ сюда не пишем.
LLM_API_KEY=
